# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Explicit text types
*.html   text
*.css    text
*.js     text
*.json   text
*.md     text
*.svg    text

# Binary assets — never diff or convert
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
